{
  "name": "cloudflare-relation-net",
  "private": true,
  "version": "0.1.0",
  "description": "Personal relationship network — family tree, relation graph, map, timeline. React + Vite + AntD on Cloudflare Workers + D1.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "bash scripts/deploy.sh",
    "demo": "wrangler d1 execute relation-net-db --local --file=scripts/demo-data.sql",
    "demo:remote": "wrangler d1 execute relation-net-db --remote --file=scripts/demo-data.sql",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@ant-design/icons": "^5.6.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.8",
    "@types/d3-force": "^3.0.10",
    "antd": "^5.29.3",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "family-chart": "^0.9.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.14.0",
    "lunar-javascript": "^1.7.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260503.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wrangler": "^4.87.0"
  }
}
